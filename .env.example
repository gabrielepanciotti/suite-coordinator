# Coordinator M1 — configuration (see spec §7)
# Copy to .env and fill in the values. .env is gitignored.

# --- Telegram ---
# Token of a NEW dedicated bot (create with @BotFather). Do not reuse another bot.
# For the forum/topic model: in @BotFather run /setprivacy -> Disable, so the bot
# can read normal messages inside the group (not only commands).
TELEGRAM_BOT_TOKEN=

# --- Extra, node-dedicated bots (optional) ---
# Leave COORDINATOR_BOTS empty and NOTHING changes: the Coordinator runs the
# single bot above, exactly as it always has.
#
# Each name listed here becomes a second Telegram surface bound to ONE Life
# node, with a deliberately small menu (/start -> the node's children, a tap
# opens a session in that node) — every other node stays reachable by
# navigating inside these chats. Telegram allows one getUpdates per token, so
# N bots means N tokens from @BotFather; a token reused twice is rejected at
# startup instead of earning a permanent 409 Conflict.
#
#   COORDINATOR_BOTS=chef,travel,casa,health
#   TELEGRAM_BOT_TOKEN_CHEF=          # per-bot token; <NAME> is the name upper-cased
#   TELEGRAM_BOT_TOKEN_TRAVEL=
#   COORDINATOR_BOT_NODE_CASA=homeResearcher   # see below — NOT optional here
#   COORDINATOR_BOT_LABEL_HEALTH=     # optional: menu title
#   COORDINATOR_BOT_INSTANCE_CASA=personal  # optional: Life instance of the menu
#
# COORDINATOR_BOT_INSTANCE_<NAME> pins which Life instance's graph the bot
# navigates (#78). Leave it empty: at boot the instance is derived from the menu
# root through the composed graphs of the registered instances, so a bot rooted
# on a node that lives in exactly one instance (e.g. 'comunity') gets that
# instance automatically. Set it only for an ambiguous node (present in more
# than one instance) — the device default wins otherwise.
#
# COORDINATOR_BOT_NODE_<NAME> is optional ONLY when the bot's name is itself a
# project key: absent, the node defaults to the bot name. Bot 'casa' serves the
# node 'homeResearcher', so without this line it binds to a node called "casa"
# that does not exist — and a bot bound to nothing polls fine, greets nobody and
# drops every message. That cost a mute room from 2026-08-06 to 2026-08-07.
# Startup now refuses to call such a bot "ready" and logs the missing variable
# by name, but the cheapest fix is still to set it here.
#
# A bot whose token is missing or malformed is logged and SKIPPED; the default
# bot and the other extra bots are unaffected.
# Which bot serves a project is declared project-side, in
# <workspace>/.claude/coordinator.toml -> [telegram] bot = "chef".
COORDINATOR_BOTS=

# TTL (seconds) of the in-process cache of Life's node graph, used to build the
# node menus. The graph comes from life_backend (/api/graph) with the same
# disk-cache fallback the project registry uses.
NODE_GRAPH_TTL_SEC=600

# Whitelist of Telegram USER ids allowed to use the bot (comma-separated).
# Authorizing by user works both in private chats and in the forum group.
# (ALLOWED_CHAT_IDS is still accepted as a fallback alias.)
ALLOWED_USER_IDS=

# --- Profili utente (M3) — visibilità per-progetto, default deny ---
# Mappa user id Telegram -> profilo (comma-separated). I profili sono definiti in
# profiles.py: `owner` (admin, sees all projects) and `member` (sees only
# personalChef · Mycorise · Travel · ExperienceFinder · StayFinder · TransportFinder ·
# scheduler). Un utente senza profilo non vede né può raggiungere alcun progetto.
#   PROFILE_OWNER_IDS=<your user id>
#   PROFILE_MEMBER_IDS=<member user id>
# FALLBACK retrocompatibile: se NESSUNA PROFILE_*_IDS è impostata, gli id in
# ALLOWED_USER_IDS sono trattati come admin (= profilo owner), così i setup
# mono-utente esistenti continuano a funzionare senza modifiche. Appena imposti
# anche solo una PROFILE_*_IDS, il fallback si disattiva e vale il default deny.
# PROFILE_OWNER_IDS=
# PROFILE_MEMBER_IDS=

# If set, free-text messages with no active agent go to this agent key
# (e.g. "toni"); if empty, the bot shows /agenti instead.
DEFAULT_AGENT=

# --- Claude headless ---
CLAUDE_BIN=claude
# Boot magro per messaggio (latenza): modello rapido + niente hook/plugin/MCP
# globali ad ogni turno. OAuth e skill/agenti di progetto restano attivi.
CLAUDE_MODEL=sonnet                 # opus se serve piu' potenza
CLAUDE_SETTING_SOURCES=project,local  # omette "user" -> salta hook+plugin globali
CLAUDE_STRICT_MCP=1                 # 0 per ricaricare i server MCP
CLAUDE_TIMEOUT_SEC=300
# Silenzio ammesso mentre un tool e' in corso (tool_use senza tool_result): build/test lunghi (#ComUnity189)
CLAUDE_TOOL_IDLE_TIMEOUT_SEC=1200
SESSION_TTL_SEC=1800
STALE_MAX_AGE_SEC=600

# --- Backend switch (global for now; per-project/agent/session is a follow-up) ---
# AI_BACKEND=claude keeps today's behaviour. AI_BACKEND=opencode routes every
# bot through `opencode run` instead of `claude -p` (2026-08-09, DeepSeek V4
# Flash pilot) -- needs OPENCODE_BIN on PATH and DEEPSEEK_API_KEY set.
# AI_BACKEND=opencode
# OPENCODE_BIN=opencode
# OPENCODE_MODEL=deepseek/deepseek-v4-flash
# DEEPSEEK_API_KEY=

# --- HomeAssistant (provider growbox, M4) ---
# HA e Coordinator sullo stesso PC: dal container usare host.docker.internal.
# HA_TOKEN vuoto = provider growbox in stub (nessun dato), non crasha.
HA_BASE_URL=http://host.docker.internal:8123
HA_TOKEN=

# --- Health (provider regime, #49) ---
# Base URL del backend Health: il provider chiama /api/persons/{slug}/agenda/next
# al momento dell'invio. Health giu' = notifica non inviata (mai un testo vuoto).
# Dal container: host.docker.internal (gab-server non risolve dentro Docker).
# HEALTH_URL=http://host.docker.internal:10030
# HEALTH_TIMEOUT_SEC=10
# Istanza Life a cui va la coda del brain (vocali #56): checkout del repo
# dell'istanza (es. life-personal), montato rw su /life-instance.
# LIFE_INSTANCE_HOST_DIR=${LIFE_INSTANCE_DIR}/life-personal
# Registro istanze del device (Coordinator#78, Life §4.1): il Coordinator e' un
# OPERATORE e serve tutte le istanze registrate sul device. Queste due vengono
# montate a path IDENTICO dentro e fuori il container, perche' instances.json
# contiene path assoluti delle istanze: un mount sotto un path neutro farebbe
# sembrare ogni istanza `unreachable`. LIFE_HOME_HOST_DIR e' la dir ~/.life
# (default ~/.life se lasciata vuota); LIFE_INSTANCES_HOST_DIR e' la cartella che
# CONTIENE i checkout life-<id> (di solito la root dei progetti, es. ~/personal).
# Lasciate vuote su un device senza registro: resta mono-istanza (legacy).
# LIFE_HOME_HOST_DIR=${LIFE_HOME}
# LIFE_INSTANCES_HOST_DIR=${LIFE_INSTANCES_DIR}
# Istanze in cartelle madri DIVERSE: un checkout per slot (1..4), al suo path,
# al posto di LIFE_INSTANCES_HOST_DIR. Mai la root dei progetti intera.
# LIFE_INSTANCE_MOUNT_1=${LIFE_WORK_DIR}/life-acme
# LIFE_INSTANCE_MOUNT_2=${LIFE_PERSONAL_DIR}/life-personal
# Vocali Telegram -> coda del brain dell'istanza (#56). Trascrizione locale faster-whisper
# (modello `small` gia' nell'immagine). In chat diretta il nodo si nomina nelle prime
# parole ("Casa, ..."): chiave, alias o label del nodo, piu' questi alias parlati.
# VOICE_DEFAULT_NODE=life
# VOICE_NODE_ALIASES=casa=home
# VOICE_WHISPER_MODEL=small
# VOICE_WHISPER_LANGUAGE=it
# Notifiche schedulate (persistenza). Default ok in Docker.
# NOTIF_PATH=/app/data/notifications.json
# Deroga per-device al ban delle notifiche di progetti `personal` (2026-06-15).
# NON impostata = si usa la default committata in notifications.py (i report dei
# nodi personali). Elenco separato da virgole/spazi = solo quelle chiavi.
# "*" = tutte (device personale: una notifica nuova non nasce muta).
# Valore presente ma vuoto = nessuna chiave personal ammessa (device work).
# NOTIFICATION_ALLOWLIST=*

# --- watchdog notifiche mute (notif_health.py) ---
# Il guasto che copre: una notifica smette di partire e NIENTE cambia colore.
# Nessuna eccezione, nessuno stato rosso, solo un'assenza — e un'assenza somiglia
# a "non c'era nulla da dire". Cosi' 14 notifiche sono restate mute un mese.
# `GET /api/notifications/health` risponde sempre; queste variabili servono solo
# all'AVVISO periodico su Telegram.
#
# Dove arriva l'avviso. Non impostata = nessun avviso periodico (l'endpoint lo
# dice: watchdog.present=false, status=critical). E' un chat id, cioe' un dato
# personale: vive SOLO qui, in .env gitignored, mai in un file versionato.
# NOTIF_HEALTH_DEST=chat:<id>
# Cadenza dell'avviso (crontab 5 campi). Default: ogni mattina alle 9.
# NOTIF_HEALTH_SCHEDULE=0 9 * * *
# Quante occorrenze consecutive perse prima di allarmare (default 2) e slack
# aggiuntivo in secondi (default 6h). Il silenzio tollerato di ogni notifica e'
# `cadenza * occorrenze + slack`: una settimanale muta da 3 giorni non e' un
# allarme, una giornaliera si'.
# NOTIF_HEALTH_MISSED_FIRES=2
# NOTIF_HEALTH_GRACE_SEC=21600

# --- provider `report` ---
# Radice dei file che il provider `report` puo' leggere. Serve a consegnare un
# report che un job del nodo ha GIA' scritto su file (es. la deriva di rete che
# Life produce alle 7:25), senza spendere una sessione Claude per rileggerlo.
# Una notifica si crea da chat: confinare la lettura ai workspace impedisce che
# diventi una lettura di file arbitrari. Il default va bene in Docker.
# REPORT_PROVIDER_ROOT=/workspaces

# --- Misc ---
TZ=Europe/Rome

# Append-only conversation log (one JSON object per turn: full prompt+reply,
# agent, topic, session, latency). Defaults to /app/data/conversations.jsonl.
# CONV_LOG_PATH=/app/data/conversations.jsonl

# Host path of ~/.claude (the dir holding the OAuth .credentials.json), mounted
# read/write into the container so `claude --resume` can persist session
# transcripts under ~/.claude/projects. On Windows, e.g. %USERPROFILE%/.claude
CLAUDE_HOST_DIR=

# --- Workspaces (host path -> /workspaces/<name>) ---
# One variable per project. On this machine all workspaces live under $SRV_ROOT
# (personal nodes are cloned there). Example:
#   WS_PERSONALCHEF=$SRV_ROOT/PersonalChef
#   WS_OFFERTE=$SRV_ROOT/Offerte
# personali (clonati su $SRV_ROOT)
# Life e' la radice della rete: da qui si creano, si ritirano e si riallineano
# i nodi, perche' e' il solo posto in cui vivono il grafo e il registro porte.
WS_LIFE=
WS_PERSONALCHEF=
WS_MYCORISE=
WS_TRAVEL=
WS_EXPERIENCEFINDER=
WS_STAYFINDER=
WS_TRANSPORTFINDER=
# cluster Finance (Life#81/#82, #50): finance ha un gruppo Telegram servito dal
# bot condiviso; expenseTracker si raggiunge dal menu del cluster.
WS_FINANCE=
WS_EXPENSETRACKER=
# work instance projects
WS_OFFERTE=
WS_CRUSCOTTO=
WS_ETL=
WS_DB=
WS_SEGNALATORI=
WS_SCHEDULER=
WS_NETWORK=
WS_TABELLA=
# config globale Claude Code (di default ~/.claude se vuoto)
WS_CLAUDE_CONFIG=

# --- Grafo Life (un file, due consumatori) --------------------------------
# Percorso HOST del grafo dei nodi Life. Serve a life_graph_drift() e, come
# ultimo anello del fallback, al menu Telegram: senza, il primo e' un no-op che
# dice "nessuna deriva" e il secondo un menu vuoto che sembra "niente da
# mostrare". Se il repo Life non ha il bundle generato (life.graph.json, che e'
# gitignored) usa il catalogo tracciato life.graph.default.json.
LIFE_GRAPH_FILE=
# Dove quel file finisce DENTRO il container: e' il target del mount qui sopra.
# Lasciala cosi' salvo che tu cambi il mount.
LIFE_CATALOG_PATH=/life.graph.json
# API di life_backend, quando ne esiste una raggiungibile da questo container.
# E' la sorgente preferita; il catalogo su disco e' solo il ripiego.
LIFE_BACKEND_URL=

# IMPORTANT: do NOT set ANTHROPIC_API_KEY here.
# If present, Claude would use the paid API instead of the OAuth subscription.
# ANTHROPIC_API_KEY=

# --- Network bus integration (M-hub, Fase 1: personale) ---
# "AgentHub" was this bus's former name; the ports it used (8030/3030/5430 and the
# published 8031/3031) were retired on 2026-06-24. The canonical port is the Life
# registry one, 10002 -- pointing at the old ones gives "connection refused", which
# every listener retries forever without ever surfacing.
# Leave HUB_TENANTS empty to disable the integration entirely.
HUB_URL=http://host.docker.internal:10002
HUB_TENANTS=personale
# Shared TENANT key (legacy auth path). Whoever holds it can impersonate EVERY
# agent of the tenant, so it is being retired: fill HUB_AGENT_KEYS below and
# leave this empty. When it is empty the integration stays enabled as long as
# HUB_AGENT_KEYS is populated.
HUB_API_KEY_PERSONALE=
# Per-agent bus keys — "agent:key,agent:key". ONE key per bus identity the
# Coordinator acts as: every name in HUB_LOCAL_AGENTS plus HUB_TELEGRAM_AGENT.
# Sent as X-Agent-Key, which identifies the agent on its own, so revoking the
# tenant key above does not disconnect anything listed here. Any identity NOT
# listed silently... does not: it falls back to the tenant key and logs a
# "bus auth DEGRADED for agent 'x'" warning at first use — grep for it.
HUB_AGENT_KEYS=
HUB_TELEGRAM_AGENT=telegram-owner
# Forum supergroup id where 🛰 conversation topics are created (must have Topics on).
HUB_TELEGRAM_CHAT_ID=
# Network web UI base: ogni post Telegram su una conversazione bus linka
# <base>/conversations/<id> (#66). Vuoto = niente link.
NETWORK_UI_URL=
# network-agent:coordinator-project-key, comma-separated
HUB_LOCAL_AGENTS=personalChef-local:personalChef,mycorise-local:mycorise
HUB_TURN_CAP=12
# Route outbound sends (dispatch agent->agent, Telegram reply) through the A2A
# protocol (POST /a2a/agents/{name}) instead of the bus custom REST API.
# 0 = custom REST (default) ; 1 = A2A. Receiving (SSE listener) stays on REST.
HUB_USE_A2A=0
# A2A push webhook (INBOUND receiving). Set HUB_A2A_WEBHOOK_URL to the base URL
# Network can POST to (this node's notifications API, default :8018) to receive
# bus events via push instead of SSE. When set, SSE listeners are SKIPPED for
# the listened agents (mutual exclusion — no double delivery) and a per-agent
# push config is auto-registered at boot. Empty = disabled (SSE as usual).
#   e.g. HUB_A2A_WEBHOOK_URL=http://host.docker.internal:8018
HUB_A2A_WEBHOOK_URL=
HUB_A2A_WEBHOOK_TOKEN=

# --- Dynamic Telegram ownership (minipc <-> PC). Empty PEER_OWNERSHIP_URL = disabled.
# Spec: docs/superpowers/specs/2026-06-10-telegram-dynamic-ownership-design.md
# DEVICE_NAME=pc                    # optional: defaults to LIFE_DEVICE (#83 F5)
OWNER_PRIORITY=100                  # PC=100, minipc=10: highest alive wanting owner polls
OWNERSHIP_PORT=8013                 # Coordinator's reserved port, published on the tailnet
PEER_OWNERSHIP_URL=                 # e.g. http://<peer-tailnet-ip>:8013
OWNERSHIP_BIND_HOST=0.0.0.0         # bind host of the status endpoint inside the container
OWNERSHIP_PROBE_INTERVAL=15         # seconds between peer probes
OWNERSHIP_FAIL_THRESHOLD=3          # missed probes before standby takes over
# Shared secret of the handoff (Coordinator#88): POST /ownership[/<dominio>]/handoff
# wants it in X-Ownership-Token. SAME value on every peer of the ladder (dev-linux,
# minipc, PC, VPS). GET /ownership stays open (probes). Empty = handoff refused (503),
# failover unaffected. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
OWNERSHIP_TOKEN=
# Intentionally blank: set it only in the private runtime environment.
SCHEDULER_ENABLED=1                 # scheduled notifications: 1 only on the minipc
# PersonalChef desktop parity mount (real ~/.claude, NOT the dedicated coordinator home)
PERSONALCHEF_DESKTOP_PROJECTS=

# --- Node DB (Life fractal, ADDITIVE/optional) ---
# Coordinator's own Postgres. Registry-assigned db port for this node is 11139
# (internal container port stays 5432). This is an OPT-IN mirror of the bridge
# domain (notifications + run history); the node still persists everything in
# data/*.json, so leaving DATABASE_URL unset changes nothing. Never points at
# personal_db. Bring the DB up with: docker compose up -d db ; then migrate
# with: .venv/Scripts/alembic upgrade head
DB_USER=coordinator
DB_PASSWORD=coordinator
DB_NAME=coordinator
DB_HOST_PORT=11139
DATABASE_URL=postgresql+psycopg://coordinator:coordinator@localhost:11139/coordinator

# --- Shared M365 token cache (graph_mailer: butler e-mail drafts) ---
# HOST DIRECTORY holding the shared MSAL cache of the installation's app
# registration (its SERVICE account, see locale/defaults.json). Compose mounts it
# at /secrets/m365 and the bot reads token_cache.json from there.
# Two rules, both load-bearing (see docker-compose.yml):
#  * it is a DIRECTORY, not a file — MSAL persists the cache with a tmp file +
#    os.replace(), which fails with EBUSY on a single-file bind mount;
#  * the mount is READ-WRITE — Entra rotates the refresh token and MSAL must be
#    able to write it back; `:ro` would break auth for the whole ecosystem.
# Never create a new app registration or a device-code login for this bot.
# It lives next to the shared auth library (relative to this repo, or absolute).
# Unset = ./data/m365 (empty: the mailer reports itself off).
# NOTE (#89): coordinator-bot no longer mounts it — only docker-compose.prod.yml
# (the prod workers) still reads this variable.
M365_TOKEN_CACHE_DIR=

# --- API :10001 auth (Coordinator#88) ---
# Every route wants it in X-Api-Token (or Authorization: Bearer), except
# /api/health and /api/overview (public node card) and the routes with a secret of
# their own (/api/cards X-Card-Token, A2A webhook, /api/vision/receipt). Empty = the
# API answers 503: closed, never open. The frontend's Vite proxy sends it (compose
# passes it to coordinator-frontend). Per device: callers on that device need it
# (Launcher COORDINATOR_API_TOKEN, Health, ComUnity announce scripts...).
COORDINATOR_API_TOKEN=
# Extra Host names the notifications UI (Vite) accepts, comma list, per device:
# the machine's own name (minipc: gab-server). Unlisted names get 403.
FRONTEND_ALLOWED_HOSTS=
# POST /api/vision/receipt (PersonalChef) wants it in X-Vision-Token. Mandatory:
# empty = 503.
VISION_TOKEN=

# --- Generic remote card protocol (Coordinator#45, TicketManager#40) ---
# A Life node posts a ready card (text + buttons), the bot renders it without
# knowing what it is; taps go back to the node's own HTTP API. See spec §4:
# docs/superpowers/specs/2026-09-21-ticketmanager-split-design.md (TicketManager repo).
#
# CARD_SOURCES: comma-separated "alias=url" list of nodes allowed to POST
# /api/cards. An alias with no matching CARD_SOURCE_TOKEN_<ALIAS> below is
# skipped (logged) — never registered with an empty secret.
#   CARD_SOURCES=tm=http://100.101.15.47:10055
# CARD_SOURCE_TOKEN_<ALIAS UPPER>: per-source bearer token, checked against the
# node's X-Card-Token header with a constant-time compare. Same value the node
# sets as its own CARD_TOKEN (see TicketManager/.env.example).
#   CARD_SOURCE_TOKEN_TM=
CARD_SOURCES=
CARD_SOURCE_TOKEN_TM=

# Where the dedup map (source, card_id) -> message_id is persisted, capped at
# 500 entries. Default matches the other data/*.json stores (notif_store.py).
REMOTE_CARDS_PATH=/app/data/remote_cards.json

# --- Sentinella: monitoraggio del box prod --------------------------------
# Nata dall'outage 8-13 agosto 2026: prod giu' cinque giorni, nessun allarme,
# perche' il job che sorvegliava girava DENTRO cio' che doveva sorvegliare.
SENTINELLA_SERVIZI_PATH=/app/data/sentinella_servizi.json
SENTINELLA_STATO_PATH=/app/data/sentinella_stato.json
# Host, chiave, riferimento tailnet e nome del box hanno default in
# locale/defaults.json (#43): qui servono solo per sovrascriverli.
SENTINELLA_SSH_HOST=
SENTINELLA_SSH_KEY=/home/app/.ssh/sentinella_key
# #89: coordinator-bot non monta piu' la chiave del box. Le sonde passano dal
# bridge host (op `sentinella-ssh`, scripts/host_sentinella.py): box, chiave e
# lista dei servizi ammessi stanno SOLO sull'host, in
# ~/.config/coordinator/sentinella.json ({"ssh_host", "ssh_key", "servizi_path"?})
# + sentinella_servizi.json accanto. 1 = sempre dal bridge; vuoto = dal bridge
# se HOST_EXEC_SSH c'e' e la chiave non e' montata.
SENTINELLA_VIA_HOST=
SENTINELLA_SSH_KEY_HOST=
# Dead-man switch: la sentinella pinga questo URL a ogni giro. Se i ping
# SMETTONO, e' il servizio esterno ad allarmare — l'unico modo di accorgersi
# che e' morta dev-linux, il Coordinator o la sentinella stessa.
SENTINELLA_DEADMAN_URL=

# Issue #46: sessioni del bus sull'host (vuoto = nel container). Setup: host-exec.md
HOST_EXEC_SSH=
HOST_EXEC_KEY_HOST=
# Progetti i cui turni TELEGRAM girano sull'host come un terminale (stessa strada
# del bus, #46). Es. HOST_EXEC_TOPIC_PROJECTS=comunity. Vuoto = tutti nel container.
# Serve HOST_EXEC_SSH e un host_path del progetto in projects.local.json.
HOST_EXEC_TOPIC_PROJECTS=

# Server Bot API locale (opzionale, lezioni > 20 MB). Vuoto = API cloud, nessun
# cambiamento. Procedura completa: .claude/docs/deployment.md "Server Bot API locale".
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Impostare SOLO dopo il logOut dei bot (scripts/telegram_local_migrate.py):
# TELEGRAM_BOT_API_URL=http://coordinator-bot-api:8081
# TELEGRAM_LOCAL_MODE=1

# gh auth for container turns (#72): host gh config dir, mounted read-only.
# Linux: /home/<user>/.config/gh. Empty = gh unauthenticated.
GH_CONFIG_HOST_DIR=
