{
  "schemaVersion": "2.0",
  "name": "Coordinator",
  "slug": "coordinator",
  "type": "bridge",
  "visibility": "public",
  "hostBase": "coordinator.life.local",
  "inherits": "../Life/node.config",
  "taxonomy": { "id": "coordinator", "cluster": ["System"], "displayName": "Coordinator", "commercial": false },
  "tooling": {},
  "capabilities": ["build", "test", "deploy"],
  "agents": { "archetypes": [] },
  "mcp": { "toolsets": ["brain", "db"], "readOnly": true },
  "deploy": {
    "mode": "bespoke",
    "database": {
      "name": "coordinator",
      "user": "coordinator",
      "host": "coordinator_db",
      "driver": "postgresql+psycopg",
      "image": "postgres:16",
      "volume": "coordinator_coordinator_db_data"
    }
  },
  "children": []
}
